ective_index": 12,\n            "FunctionValue": 0.00947755837056706,\n            "objective_values": {\n              "DoseAtPercentVolume": 4513.63232421875,\n              "VolumeAtDoseLevel": 19.956629623831176\n            }\n          },\n          {\n            "DoseLevel": 3325.0,\n            "FunctionType": "MaxDvh",\n            "PercentVolume": 32.5,\n            "Weight": 14.0,\n            "objective_index": 13,\n            "FunctionValue": 8.70671272158695e-05,\n            "objective_values": {\n              "DoseAtPercentVolume": 3429.13427734375,\n              "VolumeAtDoseLevel": 34.6137991098184\n            }\n          },\n          {\n            "DoseLevel": 2525.0,\n            "FunctionType": "MaxDvh",\n            "PercentVolume": 44.0,\n            "Weight": 21.0,\n            "objective_index": 14,\n            "FunctionValue": 0.020796537274751524,\n            "objective_values": {\n              "DoseAtPercentVolume": 2921.096923828125,\n              "VolumeAtDoseLevel": 61.44287484693678\n            }\n          },\n          {\n            "DoseLevel": 4500.0,\n            "FunctionType": "MaxDose",\n            "Weight": 75.0,\n            "objective_index": 19,\n            "FunctionValue": 0.00644333417343394,\n            "objective_values": {\n              "MaxDose": 4796.794921875\n            }\n          }\n        ]\n      },\n      "Femur_Head_R": {\n        "type": "Organ",\n        "clinical_goals": [\n          {\n            "AcceptanceLevel": 0.5,\n            "GoalCriteria": "AtMost",\n            "ParameterValue": 3000.0,\n            "Type": "VolumeAtDose",\n            "ClinicalGoalValue": 0.0,\n            "ClinicalGoalResult": true\n          },\n          {\n            "AcceptanceLevel": 0.3,\n            "GoalCriteria": "AtMost",\n            "ParameterValue": 4000.0,\n            "Type": "VolumeAtDose",\n            "ClinicalGoalValue": 0.0,\n            "ClinicalGoalResult": true\n          },\n    